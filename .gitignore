# ====================================
# Alembic Migrations
# ====================================
# Не игнорируем папку alembic/versions полностью!
# Игнорируем только автогенерируемые файлы alembic.ini (если есть шаблон)
# Сами файлы миграций должны быть в репозитории
alembic.ini.local
alembic.local.ini

# ====================================
# MinIO / S3 локальное хранилище
# ====================================
minio_data/
s3_local/
storage/
uploads/
backend/local_media/
# Не игнорируем storage-слой frontend (Clean Architecture)
!frontend/src/core/infrastructure/storage/
!frontend/src/core/infrastructure/storage/browserStorage.js
!frontend/src/core/infrastructure/storage/browserStorage.test.js
!backend/app/infrastructure/storage/
!backend/app/infrastructure/storage/__init__.py
!backend/app/infrastructure/storage/local_media.py
!backend/app/infrastructure/storage/s3.py
# Игнорируем загруженные файлы, но не структуру папок
media/*
!media/.gitkeep
!media/*.example
static/uploads/*
!static/uploads/.gitkeep

