# Backend
SECRET_KEY=CHANGE_ME_SECRET_KEY
DB_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5433/swipeit
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET_NAME=swipeit-media
S3_REGION=us-east-1
S3_SECURE=false

# Redis
REDIS_URL=redis://localhost:6379/0
ML_DEVICE=cpu
TRYON_REQUIRE_CUDA=false
TRYON_RECOVERY_INTERVAL_SECONDS=60
TRYON_STALE_PROCESSING_THRESHOLD_SECONDS=1800
TRYON_WORKER_HEARTBEAT_TTL_SECONDS=30
NVIDIA_VISIBLE_DEVICES=all

# Docker services (docker-compose.yml)
FRONTEND_IMAGE=swipeit-frontend:local
BACKEND_IMAGE=swipeit-backend:local
TRYON_WORKER_IMAGE=swipeit-backend:local
FRONTEND_HOST_PORT=80
FRONTEND_APP_NAME=Swipelt
FRONTEND_REACT_APP_API_BASE_URL=
FRONTEND_TRYON_MAX_PROCESSING_SECONDS=0
FRONTEND_USE_MOCK_DATA=false
FRONTEND_MOCK_DELAY_MS=0
FRONTEND_AUTH_INIT_DELAY_MS=300
POSTGRES_DB=swipeit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_HOST_PORT=5433
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:64,garbage_collection_threshold:0.8
PYTORCH_NO_CUDA_MEMORY_CACHING=1
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# Airflow batch (batch/airflow/docker-compose.airflow.yml)
AIRFLOW_CONN_SWIPEIT_BATCH_DB=postgresql://postgres:CHANGE_ME_DB_PASSWORD@postgres:5432/swipeit
SWIPEIT_BATCH_DB_CONN_ID=swipeit_batch_db
BATCH_DB_URL=
SWIPEIT_BATCH_IMAGE=swipeit-batch:latest
SWIPEIT_DOCKER_NETWORK=diplom_default
TRYON_INTERRUPTED_STATUSES=failed
SWIPEIT_DAG_SCHEDULE=0 2 * * *
SWIPEIT_DAG_CATCHUP=true
SWIPEIT_DAG_RETRIES=2
SWIPEIT_DAG_RETRY_DELAY_MINUTES=5
SWIPEIT_TASK_TIMEOUT_MINUTES=30
SWIPEIT_DAGRUN_TIMEOUT_MINUTES=60
SWIPEIT_MAX_ACTIVE_RUNS=1
SWIPEIT_MAX_ACTIVE_TASKS=2
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_FIRSTNAME=Air
AIRFLOW_ADMIN_LASTNAME=Flow
AIRFLOW_ADMIN_EMAIL=admin@example.com
